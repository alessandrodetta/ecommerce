  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Backend",
      "request": "launch",
      "mainClass": "com.cce.ecommerce.EcommerceWebAppApplication",
      "projectName": "",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "chrome",
      "name": "Frontend (+Vite start)",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "npm: dev - frontend"
    }
  ]
}
